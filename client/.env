# ============================================
# CLIENT ENVIRONMENT VARIABLES
# ============================================

# Environment Mode
NEXT_PUBLIC_ENV=development
VITE_ENV=development

# Live Server Backend API URL
NEXT_PUBLIC_API_URL=https://on-demand-service-platform-server.vercel.app
VITE_API_URL=https://on-demand-service-platform-server.vercel.app

NEXT_PUBLIC_API_LIVE=https://on-demand-service-platform-server.vercel.app
VITE_API_LIVE=https://on-demand-service-platform-server.vercel.app

# Local Development Server API URL
NEXT_PUBLIC_API_LOCAL=http://localhost:5000
VITE_API_LOCAL=http://localhost:5000

# Backend URL used by Vite Redux Toolkit APIs
VITE_BACKEND_URL=http://localhost:5000
