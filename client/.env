# ============================================
# CLIENT ENVIRONMENT VARIABLES
# ============================================

# Environment setting
NEXT_PUBLIC_ENV=development
VITE_ENV=development

# API URLs
NEXT_PUBLIC_API_LIVE=https://on-demand-server.vercel.app
NEXT_PUBLIC_API_LOCAL=http://localhost:5000

VITE_API_LIVE=https://on-demand-server.vercel.app
VITE_API_LOCAL=http://localhost:5000

# Backend URL used by Vite Redux Toolkit APIs
# Set to http://localhost:5000 for local dev or https://on-demand-server.vercel.app for production
VITE_BACKEND_URL=http://localhost:5000
